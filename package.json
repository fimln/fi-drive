{
  "name": "fi-drive",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "npm --prefix web ci && npm --prefix web run build",
    "dev": "wrangler dev --host localhost --local-upstream localhost",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply fi-drive-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fi-drive-db --remote",
    "test": "node scripts/test-access-jwt.mjs && cd web && node test-public-link.mjs",
    "test:e2e": "node scripts/test-worker-e2e.mjs"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
